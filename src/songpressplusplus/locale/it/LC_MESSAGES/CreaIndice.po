#: CreaIndice.py
msgid "Index"
msgstr "Indice"

#: CreaIndice.py
msgid ""
"The 'reportlab' module is not installed.\n"
"\n"
"Install it with:\n"
"    pip install reportlab"
msgstr ""
"Il modulo 'reportlab' non è installato.\n"
"\n"
"Installalo con:\n"
"    pip install reportlab"

#: CreaIndice.py
msgid "No."
msgstr "N."

#: CreaIndice.py
msgid "Title"
msgstr "Titolo"

#: CreaIndice.py
msgid "Main folder"
msgstr "Cartella principale"

#: CreaIndice.py
msgid "Choose the folder with the songs"
msgstr "Scegli la cartella con i brani"

#: CreaIndice.py
msgid "Include subfolders"
msgstr "Includi anche le sottocartelle"

#: CreaIndice.py
msgid "File extension"
msgstr "Estensione dei file"

#: CreaIndice.py
msgid "All files"
msgstr "Tutti i file"

#: CreaIndice.py
msgid "Other…"
msgstr "Altro…"

#: CreaIndice.py
msgid "Other:"
msgstr "Altro:"

#: CreaIndice.py
msgid "Index title:"
msgstr "Titolo dell'indice:"

#: CreaIndice.py
msgid "Generate PDF"
msgstr "Genera PDF"

#: CreaIndice.py
msgid "Please select a valid folder."
msgstr "Seleziona una cartella valida."

#: CreaIndice.py
msgid "Warning"
msgstr "Attenzione"

#: CreaIndice.py
msgid "Scanning files…"
msgstr "Scansione dei file in corso…"

#: CreaIndice.py
msgid "No files found with the selected extension."
msgstr "Nessun file trovato con l'estensione selezionata."

#: CreaIndice.py
msgid "No results"
msgstr "Nessun risultato"

#: CreaIndice.py
msgid "Save the index as…"
msgstr "Salva l'indice come…"

#: CreaIndice.py
msgid "PDF files (*.pdf)|*.pdf"
msgstr "File PDF (*.pdf)|*.pdf"

#: CreaIndice.py
msgid "Error"
msgstr "Errore"

#: CreaIndice.py
msgid ""
"Could not create the file:\n"
"%s"
msgstr ""
"Impossibile creare il file:\n"
"%s"

#: CreaIndice.py
msgid "Created the index with %d songs"
msgstr "Creato l'indice con %d brani"

#: CreaIndice.py
msgid " (%d without a number, placed at the end)"
msgstr " (%d senza numero, messi in fondo)"

#: CreaIndice.py
msgid "Done: %s"
msgstr "Fatto: %s"

#: CreaIndice.py
msgid "Index created"
msgstr "Indice creato"

#: CreaIndice.py
msgid "Create Index PDF"
msgstr "Crea indice PDF"

#: CreaIndice.py
msgid "Close"
msgstr "Chiudi"

#: CreaIndice.py
msgid "Generate DOCX"
msgstr "Genera DOCX"

#: CreaIndice.py
msgid "Word files (*.docx)|*.docx"
msgstr "File Word (*.docx)|*.docx"

#: CreaIndice.py
msgid ""
"The 'python-docx' module is not installed.\n"
"\n"
"Install it with:\n"
"    pip install python-docx"
msgstr ""
"Il modulo 'python-docx' non è installato.\n"
"\n"
"Installalo con:\n"
"    pip install python-docx"

#: CreaIndice.py
msgid "Background watermark (optional)"
msgstr "Immagine di sfondo (facoltativa)"

#: CreaIndice.py
msgid "Image:"
msgstr "Immagine:"

#: CreaIndice.py
msgid "Choose the watermark image"
msgstr "Scegli l'immagine di sfondo"

#: CreaIndice.py
msgid "Images"
msgstr "Immagini"

#: CreaIndice.py
msgid "Opacity (%):"
msgstr "Opacità (%):"

#: CreaIndice.py
msgid "Angle (°):"
msgstr "Angolo (°):"

#: CreaIndice.py
msgid "Size (%):"
msgstr "Dimensione (%):"

#: CreaIndice.py
msgid "Rendering:"
msgstr "Rendering:"

#: CreaIndice.py
msgid "Colour"
msgstr "Colori"

#: CreaIndice.py
msgid "Black and white"
msgstr "Bianco e nero"

#: CreaIndice.py
msgid ""
"The 'Pillow' module is not installed.\n"
"\n"
"Install it with:\n"
"    pip install Pillow"
msgstr ""
"Il modulo 'Pillow' non è installato.\n"
"\n"
"Installalo con:\n"
"    pip install Pillow"

#: CreaIndice.py
msgid "Open the PDF now"
msgstr "Apri il PDF ora"

#: CreaIndice.py
msgid "Exclude files with a “watermark” directive"
msgstr "Escludi i file con la direttiva «watermark»"

#: CreaIndice.py
msgid ""
"Could not open the file automatically:\n"
"%s"
msgstr ""
"Impossibile aprire il file automaticamente:\n"
"%s"

#: CreaIndice.py
msgid ""
"Could not read the watermark image:\n"
"%s\n"
"\n"
"Supported formats: %s"
msgstr ""
"Impossibile leggere l'immagine di sfondo:\n"
"%s\n"
"\n"
"Formati supportati: %s"

#: CreaIndice.py
#, python-format
msgid "Warning: with opacity above %d%% the text may be hard to read."
msgstr "Attenzione: con un'opacità superiore al %d%% il testo potrebbe essere difficile da leggere."

#: CreaIndice.py
msgid "Folder that contains the song files."
msgstr "Cartella che contiene i file dei brani."

#: CreaIndice.py
msgid "Also scan the subfolders of the main folder."
msgstr "Cerca anche nelle sottocartelle della cartella principale."

#: CreaIndice.py
msgid ""
"Leave out the songs that contain a {watermark} directive (draft or stamped "
"copies)."
msgstr ""
"Escludi i brani che contengono una direttiva {watermark} (copie di bozza o "
"timbrate)."

#: CreaIndice.py
msgid ""
"Use the files with this extension. The number in brackets is how many were "
"found."
msgstr ""
"Usa i file con questa estensione. Il numero tra parentesi indica quanti ne "
"sono stati trovati."

#: CreaIndice.py
msgid ""
"Use every text file in the folder (images, PDF and Word files are skipped)."
msgstr ""
"Usa tutti i file di testo nella cartella (immagini, PDF e file Word vengono "
"ignorati)."

#: CreaIndice.py
msgid "Type a different extension in the field on the right."
msgstr "Scrivi un'estensione diversa nel campo a destra."

#: CreaIndice.py
msgid "Custom extension, e.g. .txt or txt."
msgstr "Estensione personalizzata, ad es. .txt oppure txt."

#: CreaIndice.py
msgid ""
"Image drawn behind the text on every page. Leave empty for no watermark."
msgstr ""
"Immagine disegnata dietro al testo in ogni pagina. Lascia vuoto per non "
"usare nessuna immagine."

#: CreaIndice.py
#, python-format
msgid ""
"How opaque the image is (0-100). Above %d%% the text may become hard to read."
msgstr ""
"Quanto è opaca l'immagine (0-100). Oltre il %d%% il testo potrebbe diventare "
"difficile da leggere."

#: CreaIndice.py
msgid "Rotation of the image in degrees (-180 to 180)."
msgstr "Rotazione dell'immagine in gradi (da -180 a 180)."

#: CreaIndice.py
msgid "Width of the image as a percentage of the page width."
msgstr "Larghezza dell'immagine in percentuale della larghezza della pagina."

#: CreaIndice.py
msgid "Keep the original colours of the image."
msgstr "Mantieni i colori originali dell'immagine."

#: CreaIndice.py
msgid "Convert the image to grey tones: less distracting behind the text."
msgstr ""
"Converti l'immagine in toni di grigio: distrae meno dietro al testo."

#: CreaIndice.py
msgid "Heading printed at the top of the index."
msgstr "Titolo stampato in cima all'indice."

#: CreaIndice.py
msgid "Open the generated file with the default application."
msgstr "Apri il file generato con l'applicazione predefinita."

#: CreaIndice.py
msgid "Create the index as a Word document."
msgstr "Crea l'indice come documento Word."

#: CreaIndice.py
msgid "Create the index as a PDF file."
msgstr "Crea l'indice come file PDF."
