msgstr "Aggiungi al dizionario"

msgid "Change"
msgstr "Cambia"

msgid "Change all"
msgstr "Cambia tutto"

msgid "Spell check complete."
msgstr "Controllo ortografico completato."

msgid "1 error left"
msgstr "1 errore rimanente"

msgid "%d errors left"
msgstr "%d errori rimanenti"

msgid "Spell check options"
msgstr "Opzioni controllo ortografico"

msgid "Spell checking"
msgstr "Controllo ortografico"

msgid "Enable spell checking"
msgstr "Abilita il controllo ortografico"

msgid "Default language:"
msgstr "Lingua predefinita:"

msgid "Underline misspelled words at startup"
msgstr "Sottolinea le parole errate all'avvio"

msgid "Merge words split by inline chords (e.g. sal[LA-]varmi)"
msgstr "Unisci le parole divise dagli accordi in linea (es. sal[LA-]varmi)"

msgid ""
"Treat a chord inside a word as invisible: 'sal[LA-]varmi' is checked as "
"'salvarmi' instead of 'sal' + 'varmi'."
msgstr ""
"Considera un accordo dentro una parola come invisibile: «sal[LA-]varmi» "
"viene controllata come «salvarmi» invece di «sal» + «varmi»."

msgid "Underline colour:"
msgstr "Colore sottolineatura:"

msgid "Personal dictionary"
msgstr "Dizionario personale"

msgid "Open..."
msgstr "Apri..."

msgid "Empty"
msgstr "Svuota"

msgid "Install dictionaries..."
msgstr "Installa dizionari..."

msgid "Remove all words from the personal dictionary?"
msgstr "Rimuovere tutte le parole dal dizionario personale?"

msgid "Install dictionaries"
msgstr "Installa dizionari"

msgid "Spell checking engine not available."
msgstr "Motore di controllo ortografico non disponibile."

msgid "Installed languages:"
msgstr "Lingue installate:"

msgid "Available to download:"
msgstr "Disponibili per il download:"

msgid "Dictionaries are downloaded from the LibreOffice project."
msgstr "I dizionari vengono scaricati dal progetto LibreOffice."

msgid "Install selected"
msgstr "Installa selezionata"

msgid "Uninstall"
msgstr "Disinstalla"

msgid "  [system]"
msgstr "  [sistema]"

msgid "Remove the '%s' dictionary?"
msgstr "Rimuovere il dizionario «%s»?"

