msgstr "«%s» rimosso."

msgid "Could not remove '%s'."
msgstr "Impossibile rimuovere «%s»."

msgid "Downloading %s..."
msgstr "Scaricamento di %s..."

msgid "'%s' installed successfully."
msgstr "«%s» installata correttamente."

msgid ""
"Could not install '%s'.\n"
"\n"
"%s"
msgstr ""
"Impossibile installare «%s».\n"
"\n"
"%s"

msgid ""
"Spell checking is not available.\n"
"Install PyEnchant (pip install pyenchant) and the dictionaries (e.g. hunspell-it, hunspell-en-us)."
msgstr ""
"Il controllo ortografico non è disponibile.\n"
"Installa PyEnchant (pip install pyenchant) e i dizionari (es. hunspell-it, hunspell-en-us)."

msgid "Spell check complete. No errors found."
msgstr "Controllo ortografico completato. Nessun errore trovato."


msgid "Show icons next to buttons"
msgstr "Mostra icone accanto ai pulsanti"
