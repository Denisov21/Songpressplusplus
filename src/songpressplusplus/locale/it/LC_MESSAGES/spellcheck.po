msgid "Spell check"
msgstr "Controllo ortografico"

msgid "Not in dictionary:"
msgstr "Non nel dizionario:"

msgid "Suggestions:"
msgstr "Suggerimenti:"

msgid "Language:"
msgstr "Lingua:"

msgid "Ignore"
msgstr "Ignora"

msgid "Ignore all"
msgstr "Ignora tutto"

